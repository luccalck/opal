{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "versao": { "type": "string", "minLength": 1 },
    "data": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "resumo_geral": { "type": "string", "minLength": 1 },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "linha": { "type": "integer", "minimum": 1 },
          "tipo": { "type": "string", "enum": ["Nova funcionalidade", "Correção", "Segurança", "Interna", "Revisar"] },
          "resumo": { "type": "string", "minLength": 1 },
          "modulo": { "type": "string" }
        },
        "required": ["linha", "tipo", "resumo"]
      }
    },
    "ignorados": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true }
  },
  "required": ["versao", "data", "resumo_geral", "itens", "ignorados"]
}
